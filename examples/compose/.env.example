# Immich user whose NAMED people are matched (uuid)
FACE_API_OWNER_ID=00000000-0000-0000-0000-000000000000
# Must equal Immich -> Administration -> Settings -> Machine Learning -> Facial Recognition
FACE_API_FACE_MODEL=buffalo_l
FACE_API_MIN_SCORE=0.7
FACE_API_MAX_DISTANCE=0.5
# Must equal the running Immich version (other versions are refused)
FACE_API_EXPECTED_IMMICH_VERSION=3.4.1
# Optional
# FACE_API_RATE_LIMIT_PER_MINUTE=30
# FACE_API_SENTRY_DSN=
# Request log and face crops (only with an admin store; see README "Request log and face crops").
# Crops are biometric data: off by default. Set the same values on the API and the admin.
# FACE_API_REQUEST_LOG=true
# FACE_API_REQUEST_LOG_RETENTION_DAYS=90
# FACE_API_STORE_CROPS=none            # none | unknown | all
# FACE_API_CROP_RETENTION_DAYS=30
# FACE_API_IMMICH_URL=https://photos.example.org
